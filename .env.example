# Athena environment configuration example.
# Copy to .env and adjust for your local setup.

ATHENA_LOG_LEVEL=INFO
ATHENA_OBSERVABILITY_ENABLED=true
ATHENA_PROMETHEUS_ENABLED=true
GRADIO_ANALYTICS_ENABLED=False

# Vector stores
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM targets
LMSTUDIO_API_KEY=lm-studio
VLLM_API_KEY=vllm
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Privacy mode: LOCAL_ONLY | ALLOW_FRONTIER_WITH_CONFIRMATION | ALLOW_FRONTIER
ATHENA_PRIVACY_MODE=LOCAL_ONLY
