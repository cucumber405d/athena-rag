{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "1.0.0" }
  ],
  "title": "Athena — Web Observability",
  "uid": "athena-web-dashboard",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["athena", "rag"],
  "panels": [
    {
      "id": 1,
      "title": "Web requests total (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(athena_web_requests_total[5m])) by (route, status)", "legendFormat": "{{route}} {{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "Web request latency p50/p95/p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(athena_web_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p50 {{route}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(athena_web_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p95 {{route}}" },
        { "expr": "histogram_quantile(0.99, sum(rate(athena_web_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p99 {{route}}" }
      ]
    },
    {
      "id": 3,
      "title": "Retrieval requests by mode",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(athena_retrieval_requests_total[5m])) by (retrieval_mode)", "legendFormat": "{{retrieval_mode}}" }
      ]
    },
    {
      "id": 4,
      "title": "Retrieval latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(athena_retrieval_duration_seconds_bucket[5m])) by (le, retrieval_mode))", "legendFormat": "{{retrieval_mode}}" }
      ]
    },
    {
      "id": 5,
      "title": "Chunks returned per request",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(athena_retrieval_chunks_returned_bucket[5m])) by (le))", "legendFormat": "median chunks" }
      ]
    },
    {
      "id": 6,
      "title": "Vector store search latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(athena_vector_search_duration_seconds_bucket[5m])) by (le, backend, operation))", "legendFormat": "{{backend}} {{operation}}" }
      ]
    },
    {
      "id": 7,
      "title": "Generation requests by LLM target",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "sum(rate(athena_generation_requests_total[5m])) by (llm_target)", "legendFormat": "{{llm_target}}" }
      ]
    },
    {
      "id": 8,
      "title": "Generation latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(athena_generation_duration_seconds_bucket[5m])) by (le, llm_target))", "legendFormat": "{{llm_target}}" }
      ]
    },
    {
      "id": 9,
      "title": "External LLM blocked / confirmed",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "sum(rate(athena_external_llm_blocked_total[5m])) by (domain, llm_target)", "legendFormat": "blocked {{domain}}/{{llm_target}}" },
        { "expr": "sum(rate(athena_external_llm_confirmed_total[5m])) by (domain, llm_target)", "legendFormat": "confirmed {{domain}}/{{llm_target}}" }
      ]
    },
    {
      "id": 10,
      "title": "Errors by component",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "sum(rate(athena_web_errors_total[5m])) by (route)", "legendFormat": "web {{route}}" },
        { "expr": "sum(rate(athena_retrieval_errors_total[5m])) by (retrieval_mode)", "legendFormat": "retrieval {{retrieval_mode}}" },
        { "expr": "sum(rate(athena_generation_errors_total[5m])) by (llm_target)", "legendFormat": "generation {{llm_target}}" },
        { "expr": "sum(rate(athena_vector_search_errors_total[5m])) by (backend, operation)", "legendFormat": "vector {{backend}}/{{operation}}" }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  }
}
